{
    "name": "alexandrebulete/ddd-apiplatform-bridge",
    "description": "API Platform bridge for DDD Foundation - Pure PHP, no framework dependency",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandre Bulete"
        }
    ],
    "require": {
        "php": "^8.4",
        "alexandrebulete/ddd-foundation": "^1.5",
        "api-platform/state": "^4.2 || ^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "AlexandreBulete\\DddApiPlatformBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexandreBulete\\DddApiPlatformBridge\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "qa": [
            "@phpstan",
            "@test"
        ]
    }
}
